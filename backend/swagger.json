{
  "openapi": "3.0.0",
  "info": {
    "title": "ShopSense API Documentation",
    "description": "Vendor and Product Management System API for the ShopSense Springboard Internship Project.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:5000/api",
      "description": "Local Developer Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Enter the JWT token obtained from logging in."
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Retrieve service health status",
        "responses": {
          "200": {
            "description": "System is healthy"
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "summary": "Register a new user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "email", "password", "role"],
                "properties": {
                  "name": { "type": "string" },
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string" },
                  "role": { "type": "string", "enum": ["admin", "vendor"] },
                  "businessName": { "type": "string" },
                  "phone": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Registration successful"
          },
          "400": {
            "description": "Invalid input or user already exists"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Authenticate user and issue JWT",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful, token issued"
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "summary": "Fetch logged in user profile",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Profile details"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/vendors": {
      "get": {
        "summary": "Get all vendors",
        "parameters": [
          { "name": "search", "in": "query", "schema": { "type": "string" }, "description": "Search by businessName, owner, city" },
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["active", "pending", "suspended"] } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 10 } }
        ],
        "responses": {
          "200": {
            "description": "List of vendors"
          }
        }
      },
      "post": {
        "summary": "Create a new vendor",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["businessName", "ownerName", "email", "phone", "gst", "address", "city"],
                "properties": {
                  "businessName": { "type": "string" },
                  "ownerName": { "type": "string" },
                  "email": { "type": "string" },
                  "phone": { "type": "string" },
                  "gst": { "type": "string" },
                  "address": { "type": "string" },
                  "city": { "type": "string" },
                  "commission": { "type": "number", "default": 10 },
                  "status": { "type": "string", "enum": ["active", "pending", "suspended"], "default": "pending" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Vendor created"
          }
        }
      }
    },
    "/vendors/{id}": {
      "get": {
        "summary": "Get vendor by ID",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": {
            "description": "Vendor details"
          },
          "404": {
            "description": "Vendor not found"
          }
        }
      },
      "put": {
        "summary": "Update vendor details",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Vendor updated"
          }
        }
      },
      "delete": {
        "summary": "Remove vendor",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": {
            "description": "Vendor deleted"
          }
        }
      }
    },
    "/products": {
      "get": {
        "summary": "Get all products",
        "parameters": [
          { "name": "search", "in": "query", "schema": { "type": "string" } },
          { "name": "category", "in": "query", "schema": { "type": "string" } },
          { "name": "vendorId", "in": "query", "schema": { "type": "string" } },
          { "name": "page", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "List of products"
          }
        }
      },
      "post": {
        "summary": "Create a new product",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "sku", "category", "price", "stock", "vendorId"],
                "properties": {
                  "name": { "type": "string" },
                  "sku": { "type": "string" },
                  "category": { "type": "string" },
                  "price": { "type": "number" },
                  "stock": { "type": "integer" },
                  "reorderLevel": { "type": "integer", "default": 10 },
                  "vendorId": { "type": "string" },
                  "description": { "type": "string" },
                  "image": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Product listed"
          }
        }
      }
    },
    "/products/{id}": {
      "get": {
        "summary": "Get product by ID",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": {
            "description": "Product details"
          }
        }
      },
      "put": {
        "summary": "Update product details",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Product updated"
          }
        }
      },
      "delete": {
        "summary": "Delete product",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": {
            "description": "Product deleted"
          }
        }
      }
    },
    "/transactions": {
      "get": {
        "summary": "Get transactions",
        "parameters": [
          { "name": "vendorId", "in": "query", "schema": { "type": "string" } },
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["paid", "pending", "refunded", "failed"] } }
        ],
        "responses": {
          "200": {
            "description": "List of transactions"
          }
        }
      },
      "post": {
        "summary": "Perform a checkout transaction",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["customer", "productId", "vendorId", "qty"],
                "properties": {
                  "customer": { "type": "string" },
                  "productId": { "type": "string" },
                  "vendorId": { "type": "string" },
                  "qty": { "type": "integer" },
                  "paymentMethod": { "type": "string", "enum": ["card", "upi", "wallet", "bank"], "default": "upi" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Transaction completed"
          }
        }
      }
    },
    "/transactions/{id}": {
      "get": {
        "summary": "Get transaction details by ID",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": {
            "description": "Transaction details"
          }
        }
      }
    },
    "/analytics": {
      "get": {
        "summary": "Retrieve metrics for the dashboard",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Dashboard statistics and graphs datasets"
          }
        }
      }
    }
  }
}
